# Customer chat is gated by an access-code login screen.
# These variables are read by the Next.js server only. Browser
# requests proxy through /api/* routes which forward to NestJS.
# Never set OpenAI, Anthropic, Pinecone, or Salesforce secrets here.

# Required: base URL of the NestJS AI API. Server-side only.
AI_API_BASE_URL=http://localhost:3000

# Optional: read-only bearer (scope `agentforce:orchestrator-read`) for the
# server-side proxy behind /api/orchestrator/[workflowId]. Required only to
# use the read-only first-node orchestration view at /orchestration. Never
# exposed to the browser.
AI_API_ORCHESTRATOR_VIEW_TOKEN=

# Demo Case create — server-side bearer (scope `agentforce:demo-case-create`) for
# POST /api/demo/cases → NestJS POST /demo/cases. Pair with DEMO_CASE_CREATE_ENABLED=true.
# Register the SHA-256 hash in ai-api AI_API_AGENTFORCE_BEARERS_JSON. Never expose to browser.
AI_API_DEMO_CASE_CREATE_TOKEN=
DEMO_CASE_CREATE_ENABLED=false
DEMO_CASE_CREATE_RATE_LIMIT_WINDOW_MS=60000
DEMO_CASE_CREATE_RATE_LIMIT_MAX_REQUESTS=10

# Operator orchestration login — same value as ai-api ORCHESTRATOR_OPERATOR_ACCESS_CODE.
# Server-only: demo Case create uses it to mint an httpOnly session cookie and auto-start
# a stepped run; the stepped console uses it when an operator signs in manually.
ORCHESTRATOR_OPERATOR_ACCESS_CODE=

# Optional public branding strings used to render the login + chat shell.
BRAND_NAME=Customer Support
BRAND_SUBTITLE=Sign in with your access code to start
