# Customer chat is gated by an access-code login screen.
# These variables are read by the Next.js server only. Browser
# requests proxy through /api/* routes which forward to NestJS.
# Never set OpenAI, Anthropic, Pinecone, or Salesforce secrets here.

# Required: base URL of the NestJS AI API. Server-side only.
AI_API_BASE_URL=http://localhost:3000

# Optional public branding strings used to render the login + chat shell.
BRAND_NAME=Customer Support
BRAND_SUBTITLE=Sign in with your access code to start
