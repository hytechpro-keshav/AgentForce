{
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install --workspaces=false --no-audit --no-fund --include=dev && npm run build"
  },
  "deploy": {
    "startCommand": "npm run start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
