# Open WebUI service settings. Store real values in Railway only.
WEBUI_AUTH=True
WEBUI_SECRET_KEY=
WEBUI_URL=https://<openwebui-service>.up.railway.app
CORS_ALLOW_ORIGIN=https://<openwebui-service>.up.railway.app
FORWARDED_ALLOW_IPS=*

# Internal access policy. Configure SSO/RBAC before sharing broadly.
ENABLE_SIGNUP=False
DEFAULT_USER_ROLE=pending
ENABLE_LOGIN_FORM=True
ENABLE_PASSWORD_AUTH=True
ENABLE_API_KEYS=False
ENABLE_API_KEYS_ENDPOINT_RESTRICTIONS=True
ENABLE_VERSION_UPDATE_CHECK=False
ENABLE_PUBLIC_ACTIVE_USERS_COUNT=False
ENABLE_EASTER_EGGS=False
ENABLE_COMMUNITY_SHARING=False

# Provider wiring. OPENAI_API_KEY must be the scoped NestJS gateway JWT,
# not the real OpenAI key.
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URL=https://ai-api-production-03f5.up.railway.app/v1
OPENAI_API_KEY=
AIOHTTP_CLIENT_TIMEOUT_MODEL_LIST=15

# Disable direct local-provider paths in this deployment.
ENABLE_OLLAMA_API=False
OLLAMA_BASE_URL=
ENABLE_DIRECT_CONNECTIONS=False

# Keep Open WebUI-owned local data on the Railway volume.
DATA_DIR=/app/backend/data

# Reduce external product telemetry from the Open WebUI container.
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
