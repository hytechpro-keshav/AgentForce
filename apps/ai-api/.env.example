NODE_ENV=development
PORT=3000
AGENTFORCE_HEALTH_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

AI_API_JWT_SECRET=
AI_API_JWT_ISSUER=salesforce-agentforce
AI_API_JWT_AUDIENCE=agentforce-ai-api

RAG_ENABLED=false
DEFAULT_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_API_KEY=
VECTOR_DB_INDEX=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agentforce-knowledge-rag
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
RAG_DEFAULT_NAMESPACE=customer-self-service
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.68
EMBEDDING_CACHE_MAX_ITEMS=2048
RAG_RATE_LIMIT_WINDOW_MS=60000
RAG_RATE_LIMIT_MAX_REQUESTS=60
RAG_INGEST_RATE_LIMIT_MAX_REQUESTS=10

# Configure production secrets in Railway, not in source control. Production-like
# deployments fail startup when required health, OpenAI, JWT, or RAG/vector DB
# values are missing for the enabled route surface. Railway liveness uses
# GET /health/live and does not require AGENTFORCE_HEALTH_API_KEY.

# Demo Case create (POST /demo/cases) — disabled by default.
DEMO_CASE_CREATE_ENABLED=false

# Customer intake — OTP-verified chat Case create (see docs/sleepy-sparking-newt.md).
CUSTOMER_INTAKE_ENABLED=false
CUSTOMER_INTAKE_SKIP_EMAIL_VERIFICATION=false
CUSTOMER_INTAKE_BOOTSTRAP_ACCOUNT_ID=001g500000BsP8BAAV
CUSTOMER_INTAKE_OTP_APEX_BASE_PATH=/services/apexrest/agentforce/otp