NODE_ENV=development
PORT=3000
AGENTFORCE_HEALTH_API_KEY=

# Phase 1 health bridge only. Configure AGENTFORCE_HEALTH_API_KEY in Railway and inject the matching header from Salesforce Named Credential / External Credential for protected org-to-api checks. Production-like deployments fail startup when this value is missing. Railway liveness uses GET /health/live and does not require this key.
# Do not add OpenAI, Pinecone, Open WebUI, or customer chat secrets until their later phases.