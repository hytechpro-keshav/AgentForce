    <localTopics>
        <fullName>Issue_Reporting_16jg5000000RolV</fullName>
        <canEscalate>false</canEscalate>
        <description>Helps a tester report a service issue and create a service request while email
            verification is temporarily disabled.</description>
        <developerName>Issue_Reporting_16jg5000000RolV</developerName>
        <genAiPluginInstructions>
            <description>Use this subagent when the customer reports a problem or wants to create a
                request. Confirm the issue description, preferred contact method, and account id if
                missing. During temporary testing, do not use email verification. Use Create Service
                Request after collecting the required identifiers.</description>
            <developerName>instruction_1</developerName>
            <language xsi:nil="true" />
            <masterLabel>Instruction 1</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Route this subagent for Spanish service-issue phrasing too, including
                requests such as &quot;Necesito ayuda&quot;, &quot;No tengo servicio&quot;,
                &quot;No tengo agua&quot;, &quot;Tengo baja presion&quot;, &quot;No tengo luz&quot;,
                or other outage/problem reports in Spanish. These should map to issue reporting,
                not Off Topic.</description>
            <developerName>instruction_spanish_routing</developerName>
            <language xsi:nil="true" />
            <masterLabel>Instruction Spanish Routing</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Do not route unrelated Spanish chit-chat such as &quot;Cuentame un
                chiste&quot;
                or general small talk into Issue Reporting. Keep those requests in polite support
                fallback and answer in the same language when practical.</description>
            <developerName>instruction_spanish_off_topic_boundary</developerName>
            <language xsi:nil="true" />
            <masterLabel>Instruction Spanish Off Topic Boundary</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
