        <fullName>ServiceCustomerVerification_16jg5000000RolV</fullName>
        <canEscalate>false</canEscalate>
        <description>Verifies the customer by sending an email OTP and checking the submitted code
            before sensitive account or case actions.</description>
        <developerName>ServiceCustomerVerification_16jg5000000RolV</developerName>
        <genAiPluginInstructions>
            <description>Ask the customer for the email address or username needed to send a
                verification code. Do not reveal whether the identifier exists in Salesforce.</description>
            <developerName>username_email_address_prompt</developerName>
            <language xsi:nil="true" />
            <masterLabel>username_email_address_prompt</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Use Send Email with Verification Code after the customer provides an email
                address or username. Tell the customer that a code was sent if the identifier is
                valid, and ask them to check their inbox and spam or junk folder.</description>
            <developerName>send_verification_code</developerName>
            <language xsi:nil="true" />
            <masterLabel>send_verification_code</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Never confirm whether the email address or username matched a Salesforce
                record. Do not show account, case, billing, appointment, or service history until
                Verify Customer returns a successful verification result.</description>
            <developerName>user_email_security</developerName>
            <language xsi:nil="true" />
            <masterLabel>user_email_security</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Ask the customer to enter the verification code they received by email. If
                the code fails repeatedly, restart verification by asking for the email address or
                username again and sending a new code.</description>
            <developerName>reenter_username_or_email_address</developerName>
            <language xsi:nil="true" />
            <masterLabel>reenter_username_or_email_address</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the code does not arrive, tell the customer to wait about 1 to 2
                minutes and check spam or junk. Offer to resend the code only when needed.</description>
            <developerName>otp_delivery_guidance</developerName>
            <language xsi:nil="true" />
            <masterLabel>otp_delivery_guidance</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Tell the customer to use only the newest verification code because
                resending invalidates earlier codes.</description>
            <developerName>otp_newest_code_only</developerName>
            <language xsi:nil="true" />
            <masterLabel>otp_newest_code_only</masterLabel>
            <sortOrder>5</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Use this topic only for customer identity verification. After successful
                verification, return to the customer&apos;s original support request with the
                verified
                customer context.</description>
            <developerName>authentication_only</developerName>
            <language xsi:nil="true" />
            <masterLabel>authentication_only</masterLabel>
            <sortOrder>6</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Do not expose authentication keys, generated OTP values, internal customer
                ids, or customer type variables. Ask the customer only for the code they received.</description>
            <developerName>security_prompt</developerName>
            <language xsi:nil="true" />
            <masterLabel>security_prompt</masterLabel>
            <sortOrder>7</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>After sending a verification code, do not let the customer switch to a
                different email address or username in the same verification attempt. Restart
                verification if the customer needs to use a different identifier.</description>
            <developerName>prevent_user_switching_after_verification</developerName>
            <language xsi:nil="true" />
            <masterLabel>prevent_user_switching_after_verification</masterLabel>
            <sortOrder>8</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>After Verify Customer returns true, proceed to the requested support topic.
                If verification fails, ask for the code again or restart verification after repeated
                failures.</description>
            <developerName>proceed_after_verification_success</developerName>
            <language xsi:nil="true" />
            <masterLabel>proceed_after_verification_success</masterLabel>
            <sortOrder>9</sortOrder>
        </genAiPluginInstructions>
        <language>en_US</language>
