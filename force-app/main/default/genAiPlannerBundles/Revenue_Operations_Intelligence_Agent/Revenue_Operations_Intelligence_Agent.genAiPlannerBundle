  </genAiPlugins>
  <genAiPlugins>
    <genAiPluginName
    >Revenue_Operations_Intelligence_Account_Directory</genAiPluginName>
  </genAiPlugins>
  <genAiPlugins>
    <genAiPluginName
    >Revenue_Operations_Intelligence_Account_Health</genAiPluginName>
  </genAiPlugins>
  <masterLabel>Account Manager Revenue Intelligence Agent</masterLabel>
