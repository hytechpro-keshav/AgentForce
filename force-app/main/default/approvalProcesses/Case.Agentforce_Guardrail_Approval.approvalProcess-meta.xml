<?xml version="1.0" encoding="UTF-8" ?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case.Agentforce_Guardrail_Approval</fullName>
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula
    >AND(ISPICKVAL(AI_Guardrail_Status__c, "pending_approval"))</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Set_Guardrail_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Set_Guardrail_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Agentforce Guardrail Approval</label>
    <recordEditability>AdminOnly</recordEditability>
    <approvalStep>
        <name>Guardrail_Approver</name>
        <label>Guardrail Approver</label>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Agentforce_Guardrail_Approvers</name>
                <type>queue</type>
            </approver>
        </assignedApprover>
    </approvalStep>
</ApprovalProcess>
